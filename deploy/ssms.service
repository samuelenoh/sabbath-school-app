[Unit]
Description=Sabbath School web application
After=network.target

[Service]
User=ssms
Group=ssms
WorkingDirectory=/opt/ssms
EnvironmentFile=/etc/ssms/ssms.env
ExecStart=/opt/ssms/.venv/bin/python /opt/ssms/run_production.py
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ssms

[Install]
WantedBy=multi-user.target
