# Reference only: server.py reads environment variables, not .env files.
SSMS_ADMIN_EMAIL=admin@yourchurch.org
SSMS_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SSMS_DB=/var/lib/ssms/ssms.sqlite3
SSMS_ENV=production
SSMS_ORIGIN=https://your-church-domain.example
SSMS_SECURE_COOKIES=1
SSMS_HOST=127.0.0.1
SSMS_TRUSTED_PROXY=127.0.0.1
PORT=8000
WHATSAPP_MODE=dry_run
# Set all values on the server before switching to live.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Alternative to SSMS_DB for hosted persistent PostgreSQL; keep URL private.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
